// =============================================
// ALAYA INSIDER — ENTERPRISE NORMALIZED SCHEMA
// Prisma + PostgreSQL
// Designed for millions of monthly users
// Zero technical debt. Full normalization. Future-proof.
// Handcrafted by Principal Database + Search + Recommendation Architects
// =============================================

generator client {
  provider = "prisma-client-js"
  // Force standard library (query) engine for self-hosted PostgreSQL.
  // Prevents "client" engine which requires adapter/accelerateUrl (Prisma Accelerate / serverless).
  // This is the correct config for direct Postgres connections (Neon, local, etc.).
  engineType = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// ENUMS — Complete & Exhaustive
// =============================================

