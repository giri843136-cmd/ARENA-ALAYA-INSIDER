// =============================================
// CORE TAXONOMY — Universes & Collections
// =============================================

model Universe {
  id              String       @id @default(cuid())
  slug            UniverseSlug @unique
  title           String
  subtitle        String
  description     String       @db.Text
  longDescription String       @db.Text
  heroImage       String
  accentColor     String       @default("#C5A26F")

  order    Int     @default(0)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subcollections Subcollection[]
  products       Product[]
  articles       Article[]

  @@index([slug])
  @@index([featured, order])
}

model Subcollection {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  subtitle    String
  description String @db.Text
  heroImage   String

  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  order    Int     @default(0)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Many-to-many with products (via join table for flexibility)
  productSubcollections ProductSubcollection[]
  articleSubcollections ArticleSubcollection[] @relation("ArticleSubcollections")

  @@index([universeId])
  @@index([slug])
}

model Collection {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  subtitle    String
  description String @db.Text
  coverImage  String

  type        String // seasonal | curated | gift-guide | edit
  season      String?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Join tables
  collectionProducts CollectionProduct[]
  collectionArticles CollectionArticle[]

  @@index([slug])
  @@index([type, publishedAt])
}

// =============================================
// BRANDS — Rich Brand Vault
// =============================================

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  story       String  @db.Text
  description String? @db.Text

  website   String?
  logo      String
  heroImage String?

  country     String
  founded     Int?
  brandColors String[] // hex array
  socialLinks Json? // { instagram, tiktok, ... }

  rating       Float   @default(0)
  featured     Boolean @default(false)
  productCount Int     @default(0)

  values String[] // ["Craft", "Sustainability", ...]

  // SEO
  seoTitle        String?
  metaDescription String? @db.Text
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products       Product[]
  affiliateLinks AffiliateLink[]
  stats          BrandStat?

  @@index([slug])
  @@index([featured, rating])
  @@index([country])
}

// =============================================
// PRODUCTS — Extremely Rich Normalized Model
// =============================================

model Product {
  id   String @id @default(cuid())
  slug String @unique

  name             String
  shortDescription String
  longDescription  String @db.Text

  benefits           String[] // JSON-like array of strings
  pros               String[]
  cons               String[]
  perfectFor         String[]
  whyAlayaRecommends String[] @db.Text

  // Pricing
  price     Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)
  currency  Currency @default(USD)

  // Metrics
  rating      Float @default(0)
  reviewCount Int   @default(0)

  // Commerce
  availability Availability  @default(IN_STOCK)
  status       ProductStatus @default(DRAFT)
  sku          String?
  inventory    Int?          @default(0)

  // Attributes
  season    String?
  occasion  String?
  color     String?
  style     String?
  lifestyle String?
  country   String?

  // Embedding (pgvector for semantic search)
  embedding Unsupported("vector(1536)")?

  // Scoring (for recommendation + search)
  searchScore         Float @default(0)
  recommendationScore Float @default(0)
  affiliatePriority   Int   @default(0)

  // SEO + Schema
  seoTitle        String?
  metaDescription String? @db.Text
  canonicalUrl    String?
  schemaData      Json? // Full structured data

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  // Foreign Keys
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  // Many-to-many relationships (proper join tables)
  productSubcollections ProductSubcollection[]
  productCollections    CollectionProduct[]
  productTags           ProductTag[]
  productCategories     ProductCategory[]

  // Affiliate
  affiliateLinks AffiliateLink[]
  priceHistory   PriceHistory[]
  deals          Deal[]
  coupons        Coupon[]

  // Content
  reviews Review[]
  faqs    FAQ[]    @relation("ProductFAQs")
  media   Media[]  @relation("ProductMedia")

  // Graphs
  relatedProductsFrom RelatedProduct[] @relation("ProductRelatedFrom")
  relatedProductsTo   RelatedProduct[] @relation("ProductRelatedTo")

  // Analytics
  searchAnalytics SearchAnalytic[]
  activityLogs    ActivityLog[]

  // Back relations for joins (required for Prisma relations)
  favorites              Favorite[]              @relation("ProductFavorites")
  wishlists              Wishlist[]              @relation("WishlistProducts")
  recentlyViewed         RecentlyViewed[]        @relation("ProductRecentlyViewed")
  relatedProductArticles RelatedProductArticle[] @relation("ProductRelatedProductArticles")
  variants               ProductVariant[]
  metadata               ProductMetadata?
  recommendations        Recommendation[]
  productStats           ProductStat?

  @@index([slug])
  @@index([brandId])
  @@index([universeId])
  @@index([status, publishedAt])
  @@index([availability])
  @@index([searchScore, recommendationScore])
  @@index([price])
  @@index([deletedAt])
}

// Join tables for clean many-to-many
model ProductSubcollection {
  id              String @id @default(cuid())
  productId       String
  subcollectionId String
  order           Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcollection Subcollection @relation(fields: [subcollectionId], references: [id], onDelete: Cascade)

  @@unique([productId, subcollectionId])
  @@index([subcollectionId])
}

model CollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  order        Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
}

model ProductCategory {
  id         String @id @default(cuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([productId, categoryId])
}

// =============================================
// PRODUCT VARIANTS & METADATA
// =============================================

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku      String  @unique
  upc      String?
  gtin     String?
  color    String?
  size     String?
  material String?

  priceAdjustment Decimal     @default(0) @db.Decimal(10, 2)
  stockStatus     Availability @default(IN_STOCK)
  images          String[]
  attributes      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([upc])
}

model ProductMetadata {
  productId String @id

  asin             String?
  upc              String?
  sku              String?
  gtin             String?
  manufacturer     String?
  warranty         String?
  countryOfOrigin  String?
  weightOz         Decimal? @db.Decimal(8, 2)
  dimensionsInches Json? // { length, width, height }

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([asin])
  @@index([upc])
}

// =============================================
// ARTICLES — Editorial Engine
// =============================================

model Article {
  id   String @id @default(cuid())
  slug String @unique

  title    String
  subtitle String?
  excerpt  String  @db.Text
  content  String  @db.Text

  featuredImage String
  readingTime   Int
  difficulty    String? // beginner | intermediate | advanced

  heroQuote String?

  // SEO
  seoTitle        String?
  metaDescription String? @db.Text
  canonicalUrl    String?
  schemaData      Json?

  // Embedding (pgvector for semantic search)
  embedding Unsupported("vector(1536)")?

  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  universeId String?
  universe   Universe? @relation(fields: [universeId], references: [id])

  // Relations
  subcollections     ArticleSubcollection[] @relation("ArticleSubcollections")
  collectionArticles CollectionArticle[]

  relatedArticlesFrom RelatedArticle[] @relation("ArticleRelatedFrom")
  relatedArticlesTo   RelatedArticle[] @relation("ArticleRelatedTo")

  productRecommendations RelatedProductArticle[]
  articleTags            ArticleTag[]            @relation("ArticleTags")
  comments               Comment[]
  versions               ArticleVersion[]
  articleStats           ArticleStat?

  @@index([slug])
  @@index([status, publishedAt])
  @@index([featured])
  @@index([authorId])
}

model Author {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  bio    String @db.Text
  avatar String
  role   String
  social Json? // { instagram, substack }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
  stats    AuthorStat?

  @@index([slug])
}

model ArticleSubcollection {
  id              String @id @default(cuid())
  articleId       String
  subcollectionId String

  article       Article       @relation("ArticleSubcollections", fields: [articleId], references: [id], onDelete: Cascade)
  subcollection Subcollection @relation("ArticleSubcollections", fields: [subcollectionId], references: [id], onDelete: Cascade)

  @@unique([articleId, subcollectionId])
}

model CollectionArticle {
  id           String @id @default(cuid())
  collectionId String
  articleId    String

  collection Collection @relation(fields: [collectionId], references: [id])
  article    Article    @relation(fields: [articleId], references: [id])

  @@unique([collectionId, articleId])
}

// =============================================
// TAGS, CATEGORIES, ENTITIES (Knowledge Graph)
// =============================================

model Tag {
  id   String  @id @default(cuid())
  slug String  @unique
  name String
  type String? // lifestyle, material, color, etc.

  products ProductTag[]
  articles ArticleTag[] // if needed later

  @@index([slug])
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?

  products ProductCategory[]
  stats    CategoryStat?
  seasonalTrends SeasonalTrend[]

  @@index([slug])
}

model Entity {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  type        String // product | brand | article | concept
  description String?

  // Knowledge graph connections
  relationsFrom EntityRelation[] @relation("EntityFrom")
  relationsTo   EntityRelation[] @relation("EntityTo")

  @@index([slug, type])
}

model EntityRelation {
  id           String @id @default(cuid())
  fromId       String
  toId         String
  relationType String // "related-to", "part-of", "inspired-by", etc.
  strength     Float  @default(1.0)

  from Entity @relation("EntityFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Entity @relation("EntityTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relationType])
}

// =============================================
// AFFILIATE INTELLIGENCE SYSTEM
// =============================================

model AffiliateLink {
  id        String           @id @default(cuid())
  productId String?
  brandId   String?
  network   AffiliateNetwork

  url      String
  deepLink String?
  label    String

  commissionRate Decimal?   @db.Decimal(5, 2)
  lastChecked    DateTime?
  health         LinkHealth @default(HEALTHY)
  version        Int        @default(1)
  expiresAt      DateTime?

  clicks      Int     @default(0)
  conversions Int     @default(0)
  revenue     Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product?              @relation(fields: [productId], references: [id])
  brand       Brand?                @relation(fields: [brandId], references: [id])
  healthLogs  AffiliateLinkHealth[]

  @@index([productId])
  @@index([brandId])
  @@index([network, health])
  @@index([health])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  currency   Currency
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model Deal {
  id          String    @id @default(cuid())
  productId   String
  title       String
  description String?
  discount    Decimal?
  startsAt    DateTime?
  endsAt      DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, endsAt])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  discount    Decimal?
  type        String // percent | fixed
  expiresAt   DateTime?
  active      Boolean   @default(true)

  products Product[] // many-to-many if needed, or via join

  @@index([code])
  @@index([expiresAt])
}

// =============================================
// USER SYSTEM — Rich Profiles & Personalization
// =============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar        String?
  emailVerified DateTime?

  // Settings
  currency Currency @default(USD)
  language String   @default("en")
  theme    String   @default("light")
  blocked  Boolean  @default(false)
  passwordHash String? // bcrypt hash, set via SQL migration or seed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile        UserProfile?
  sessions       Session[]
  bookmarks      Bookmark[]
  favorites      Favorite[]
  wishlists      Wishlist[]
  savedSearches  SavedSearch[]
  recentlyViewed RecentlyViewed[]
  notifications  Notification[]
  reviews        Review[]
  activityLogs   ActivityLog[]
  aiHistory      AIHistory[]
  searchLogs     SearchLog[]
  pageViews      PageView[]
  userInteractions UserInteraction[]
  contentReviews ContentReview[]
  deviceSessions DeviceSession[]
  userAddresses  UserAddress[]
  pushSubscriptions PushSubscription[]
  recommendations Recommendation[]
  comments       Comment[]
  notificationMutes      NotificationMute[]
  notificationPreferences UserNotificationPreference?
  mediaFolders            MediaFolder[]

  roles UserRole[]

  // Security relations
  twoFactorAuth     TwoFactorAuth?
  backupCodes       BackupCode[]
  delegatedAccess   DelegatedAccess[] @relation("DelegatedAccessGranter")
  securityAuditLogs SecurityAuditLog[]

  @@index([email])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                String?  @db.Text
  location           String?
  interests          String[]
  preferredUniverses String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// Personalization
model Bookmark {
  id        String  @id @default(cuid())
  userId    String
  productId String?
  articleId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, articleId])
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation("ProductFavorites", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Wishlist {
  id       String    @id @default(cuid())
  userId   String
  name     String    @default("My Wishlist")
  products Product[] @relation("WishlistProducts")

  user User @relation(fields: [userId], references: [id])
}

model SavedSearch {
  id      String  @id @default(cuid())
  userId  String
  query   String
  filters Json?
  name    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation("ProductRecentlyViewed", fields: [productId], references: [id])

  @@unique([userId, productId])
}

// =============================================
// COMMUNITY & REVIEWS
// =============================================

model Review {
  id        String  @id @default(cuid())
  productId String
  userId    String?

  rating Int
  title  String?
  body   String  @db.Text

  pros String[]
  cons String[]

  helpful  Int          @default(0)
  verified Boolean      @default(false)
  status   ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, status])
  @@index([userId])
}

model FAQ {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  category String?

  productId String?
  product   Product? @relation("ProductFAQs", fields: [productId], references: [id])

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// =============================================
// RECOMMENDATION & RELATIONSHIP GRAPHS
// =============================================

model RelatedProduct {
  id     String @id @default(cuid())
  fromId String
  toId   String
  type   ProductRelationshipType
  score  Float  @default(1.0)
  source String // editorial | algorithm | manual

  from Product @relation("ProductRelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Product @relation("ProductRelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromId, toId, type])
  @@index([fromId, type, score])
  @@index([toId])
}

model RelatedArticle {
  id     String @id @default(cuid())
  fromId String
  toId   String
  score  Float  @default(1.0)

  from Article @relation("ArticleRelatedFrom", fields: [fromId], references: [id])
  to   Article @relation("ArticleRelatedTo", fields: [toId], references: [id])

  @@unique([fromId, toId])
}

model RelatedProductArticle {
  id        String @id @default(cuid())
  productId String
  articleId String
  score     Float  @default(1.0)

  product Product @relation("ProductRelatedProductArticles", fields: [productId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([productId, articleId])
}

// =============================================
// MEDIA SYSTEM (Cloudinary Ready)
// =============================================

model Media {
  id       String    @id @default(cuid())
  url      String
  publicId String // Cloudinary public_id
  type     MediaType @default(IMAGE)
  folder   String?
  altText  String?
  width    Int?
  height   Int?
  format   String?
  size     Int? // bytes
  versions Json? // { webp, avif, ... }

  productId String?
  product   Product? @relation("ProductMedia", fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([publicId])
  @@index([productId])
}

// =============================================
// SEO, REDIRECTS, SITEMAPS
// =============================================

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  type      Int      @default(301) // 301, 302
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([from])
}

model InternalLink {
  id         String   @id @default(cuid())
  fromUrl    String
  toUrl      String
  anchorText String
  context    String? // where the link appears
  createdAt  DateTime @default(now())

  @@index([fromUrl])
  @@index([toUrl])
}

// =============================================
// ANALYTICS, SEARCH, ACTIVITY
// =============================================

model SearchAnalytic {
  id          String   @id @default(cuid())
  query       String
  productId   String?
  resultCount Int
  clicked     Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])

  @@index([query])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [entityId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// =============================================
// AI SYSTEM — Full History & Workflow
// =============================================

model AIHistory {
  id        String   @id @default(cuid())
  userId    String?
  action    AIAction
  prompt    String   @db.Text
  output    String   @db.Text
  model     String?
  version   Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId])
}

model AutomationRule {
  id        String             @id @default(cuid())
  name      String
  type      AutomationRuleType
  config    Json
  active    Boolean            @default(true)
  lastRunAt DateTime?
  createdAt DateTime           @default(now())

  @@index([type, active])
}

// =============================================
// SETTINGS, API, SECURITY
// =============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  logs ApiLog[]

  @@index([keyHash])
}

model ApiLog {
  id              String   @id @default(cuid())
  apiKeyId        String?
  endpoint        String
  method          String   // GET, POST, PUT, DELETE, etc.
  responseStatus  Int
  responseTimeMs  Int
  ipAddress       String?
  timestamp       DateTime @default(now())

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([apiKeyId])
  @@index([endpoint])
  @@index([timestamp])
  @@index([responseStatus])
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  source      String?
  preferences Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// =============================================
// AUDIT & BACKUPS (for compliance)
// =============================================

model Backup {
  id        String   @id @default(cuid())
  type      String // full | incremental
  location  String
  size      Int?
  createdAt DateTime @default(now())
}

// =============================================
// ADDITIONAL INDEXES & COMMENTS FOR SCALING
// =============================================

// Composite indexes for common queries
// (Prisma will generate many automatically, but explicit ones here for clarity)

model ArticleTag {
  id        String @id @default(cuid())
  articleId String
  tagId     String

  article Article @relation("ArticleTags", fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  sessionId  String?
  entityType String?
  entityId   String?
  properties Json?
  timestamp  DateTime @default(now())
  source     String?
  referrer   String?
  userAgent  String?
  revenue    Decimal? @db.Decimal(12, 2)
  commission Decimal? @db.Decimal(12, 2)
  currency   String?
  network    String?

  @@index([name, timestamp])
  @@index([userId, timestamp])
  @@index([entityType, entityId])
}

// =============================================
// SEARCH & PAGE ANALYTICS
// =============================================

model SearchLog {
  id           String   @id @default(cuid())
  sessionId    String?
  userId       String?
  query        String
  resultsCount Int      @default(0)
  filters      Json?
  timestamp    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query, timestamp])
  @@index([userId])
  @@index([sessionId])
  @@index([resultsCount]) // for zero-result tracking
}

model PageView {
  id         String   @id @default(cuid())
  pageUrl    String
  pageType   PageType
  objectId   String?
  userId     String?
  sessionId  String?
  referrer   String?
  userAgent  String?
  ipHash     String?
  viewport   String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pageUrl, timestamp])
  @@index([pageType, objectId])
  @@index([sessionId])
  @@index([userId])
  @@index([timestamp])
}

model UserInteraction {
  userId          String
  targetType      String // product | article | category
  targetId        String
  interactionType InteractionType
  weight          Int      @default(1)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId, interactionType])
  @@index([userId, interactionType])
  @@index([targetType, targetId])
}

// =============================================
// EMAIL SYSTEM — Subscribers, Campaigns, Logs
// =============================================

model EmailSubscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  preferences       Json?     // { categories: [], frequency: "weekly" }
  verified          Boolean   @default(false)
  verificationToken String?
  unsubscribedAt    DateTime?
  createdAt         DateTime  @default(now())

  campaignLogs CampaignLog[]

  @@index([email])
  @@index([verified])
  @@index([unsubscribedAt])
}

model EmailCampaign {
  id              String         @id @default(cuid())
  name            String
  subject         String
  htmlContent     String         @db.Text
  audienceFilter  Json?          // { categories: ["..."], minActivityDays: 30 }
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  logs CampaignLog[]

  @@index([status])
  @@index([scheduledAt])
}

model CampaignLog {
  id           String    @id @default(cuid())
  campaignId   String
  subscriberId String
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  error        String?

  campaign   EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([subscriberId])
  @@index([openedAt])
}

// =============================================
// EDITORIAL WORKFLOW — Checklists, Reviews, Approvals
// =============================================

model ContentChecklist {
  id            String        @id @default(cuid())
  contentType   String        // article | product
  contentId     String
  checklistType ChecklistType
  items         Json          // [{ item: "Meta title length", completed: true, completedBy: "...", completedAt: "..." }]
  completedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([contentType, contentId])
  @@index([checklistType])
}

model ContentReview {
  id           String               @id @default(cuid())
  contentType  String               // article | product
  contentId    String
  reviewerId   String
  status       ContentReviewStatus  @default(PENDING)
  comments     String?              @db.Text
  createdAt    DateTime             @default(now())
  resolvedAt   DateTime?

  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([contentType, contentId])
  @@index([reviewerId])
  @@index([status])
}

// =============================================
// FEATURE FLAGS & A/B TESTING
// =============================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  percentage  Int      @default(0) // 0–100 rollout
  rules       Json?    // { userSegments: [], countries: [] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  abTests AbTest[]

  @@index([key])
  @@index([enabled])
}

model AbTest {
  id            String   @id @default(cuid())
  name          String
  hypothesis    String?  @db.Text
  featureFlagId String
  variants      Json     // { control: { value: "A" }, treatment: { value: "B" } }
  startedAt     DateTime?
  endedAt       DateTime?
  winner        String?
  createdAt     DateTime @default(now())

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  results     ExperimentResult[]

  @@index([featureFlagId])
}

model ExperimentResult {
  id         String @id @default(cuid())
  abTestId   String
  variant    String
  metricName String // ctr, revenue_per_user, etc.
  value      Decimal @db.Decimal(12, 4)
  sampleSize Int
  confidence Decimal @db.Decimal(5, 4)

  abTest AbTest @relation(fields: [abTestId], references: [id], onDelete: Cascade)

  @@index([abTestId, variant])
}

// =============================================
// MEDIA MANAGEMENT — Folders, Usage Tracking
// =============================================

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  path      String?  // Materialized path for folder hierarchy (e.g., "/root/sub/folder")
  createdBy String?
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("MediaFolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderParent")
  creator  User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([createdBy])
}

model MediaUsage {
  id         String   @id @default(cuid())
  mediaId    String
  targetType String   // product | article | category | brand | collection
  targetId   String
  usageType  String   // featured | gallery | author_avatar
  usedAt     DateTime @default(now())

  @@index([mediaId])
  @@index([targetType, targetId])
  @@unique([mediaId, targetType, targetId, usageType])
}

// =============================================
// LINK MANAGEMENT — Broken Links, Health Audits
// =============================================

model BrokenLink {
  id          String   @id @default(cuid())
  url         String
  linkType    LinkType
  sourcePage  String?  // URL where the link appears
  httpStatus  Int?
  lastChecked DateTime @default(now())
  fixedAt     DateTime?
  createdAt   DateTime @default(now())

  @@index([url])
  @@index([linkType])
  @@index([httpStatus])
  @@index([fixedAt])
}

model AffiliateLinkHealth {
  id              String   @id @default(cuid())
  affiliateLinkId String
  lastChecked     DateTime @default(now())
  isWorking       Boolean
  responseTimeMs  Int?
  redirectChain   String[]
  errorMessage    String?

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId])
  @@index([lastChecked])
  @@index([isWorking])
}

// =============================================
// SYSTEM — Webhooks, Cron Jobs
// =============================================

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String?
  events    String[] // ["product.updated", "price.changed", etc.]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String   @db.Text
  excerpt   String?  @db.Text
  status    ContentStatus
  authorId  String?
  diff      Json?    // JSON diff from previous version
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([articleId])
}

model CronLog {
  id          String    @id @default(cuid())
  jobName     String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    // success | failed
  error       String?   @db.Text
  rowsAffected Int      @default(0)

  @@index([jobName, startedAt])
  @@index([status])
}

// =============================================
// SECURITY — 2FA, Password, Login Tracking, Delegated Access
// =============================================

model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String   // TOTP secret (encrypted at rest)
  enabled   Boolean  @default(false)
  verified  Boolean  @default(false) // true after user confirms setup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BackupCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   // bcrypt hash of backup code
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  userAgent String?
  success   Boolean
  failReason String? // "invalid_password" | "account_locked" | "2fa_failed"
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model DelegatedAccess {
  id          String   @id @default(cuid())
  grantedBy   String   // userId of the primary admin (alayainsider@gmail.com)
  grantedTo   String   // userId or email of delegated user
  email       String   // email of delegated user
  role        Role     @default(EDITOR)
  permissions String[] // specific permissions granted
  active      Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  granter User @relation("DelegatedAccessGranter", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@index([grantedBy])
  @@index([email])
  @@index([active])
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String   // "login_success" | "login_failed" | "2fa_enabled" | "2fa_disabled" | "password_changed" | "access_granted" | "access_revoked" | "session_revoked"
  details      String?  @db.Text
  ipAddress    String?
  userAgent    String?
  severity     String   @default("info") // info | warning | critical
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model DeviceSession {
  id         String      @id // JTI (JWT ID)
  userId     String
  deviceName String?
  deviceType DeviceType?
  lastActive DateTime    @default(now())
  createdAt  DateTime    @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActive])
}

model UserAddress {
  id           String  @id @default(cuid())
  userId       String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("US")
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endpoint])
}

// =============================================
// PRECOMPUTED RECOMMENDATIONS & TRENDS
// =============================================

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  productId String
  score     Decimal  @db.Decimal(10, 4)
  reason    String?  // viewed | similar | trending
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, score])
  @@index([productId])
  @@index([expiresAt])
}

model SeasonalTrend {
  id         String   @id @default(cuid())
  categoryId String
  season     String   // spring | summer | fall | winter
  year       Int
  trendScore Decimal  @db.Decimal(5, 2)
  keywords   String[]

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, season, year])
  @@index([season, year])
}

// =============================================
// STATISTICS — Author, Article, Product, Category, Brand
// =============================================

model AuthorStat {
  authorId       String        @id
  totalArticles  Int           @default(0)
  totalClicks    BigInt        @default(0)
  totalRevenue   Decimal       @default(0) @db.Decimal(12, 2)
  avgReadingTime Decimal       @default(0) @db.Decimal(5, 2)
  updatedAt      DateTime      @updatedAt

  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ArticleStat {
  articleId        String   @id
  pageViews        Int      @default(0)
  uniqueVisitors   Int      @default(0)
  affiliateClicks  Int      @default(0)
  revenueGenerated Decimal  @default(0) @db.Decimal(12, 2)
  scrollDepthAvg   Decimal  @default(0) @db.Decimal(3, 2)
  timeOnPageAvg    Int      @default(0) // seconds
  updatedAt        DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ProductStat {
  productId       String   @id
  pageViews       Int      @default(0)
  affiliateClicks Int      @default(0)
  conversions     Int      @default(0)
  revenue         Decimal  @default(0) @db.Decimal(12, 2)
  favoriteCount   Int      @default(0)
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CategoryStat {
  categoryId   String   @id
  pageViews    Int      @default(0)
  productCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model BrandStat {
  brandId      String   @id
  pageViews    Int      @default(0)
  productCount Int      @default(0)
  totalRevenue Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// =============================================
// COMMENTS & NOTIFICATION MUTES
// =============================================

model Comment {
  id          String        @id @default(cuid())
  articleId   String
  parentId    String?
  userId      String?
  guestName   String?
  guestEmail  String?
  content     String        @db.Text
  upvotes     Int           @default(0)
  downvotes   Int           @default(0)
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReply")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  edits      CommentEdit[]
  auditLogs  ModerationAuditLog[]

  @@index([articleId, status])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
}

model NotificationMute {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // product | article | category
  targetId   String
  muteUntil  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

model UserNotificationPreference {
  id        String @id @default(cuid())
  userId    String @unique

  // Notification types — each is a toggle for in-app, email, and push
  priceDropEmail      Boolean @default(false)
  priceDropPush       Boolean @default(true)
  priceDropInApp      Boolean @default(true)
  dealAlertEmail      Boolean @default(false)
  dealAlertPush       Boolean @default(true)
  dealAlertInApp      Boolean @default(true)
  newArticleEmail     Boolean @default(false)
  newArticlePush      Boolean @default(false)
  newArticleInApp     Boolean @default(true)
  commentReplyEmail   Boolean @default(false)
  commentReplyPush    Boolean @default(true)
  commentReplyInApp   Boolean @default(true)
  weeklyDigestEmail   Boolean @default(true)
  backInStockEmail    Boolean @default(false)
  backInStockPush     Boolean @default(true)
  backInStockInApp    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================
// COMMENT EDITS & MODERATION AUDIT LOGS
// =============================================

model CommentEdit {
  id           String   @id @default(cuid())
  commentId    String
  editorId     String?
  originalText String   @db.Text
  editedText   String   @db.Text
  createdAt    DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([createdAt])
}

model ModerationAuditLog {
  id         String   @id @default(cuid())
  commentId  String?
  editorId   String?
  action     String   // approve | reject | delete | restore | edit | block_user
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  source     String   @default("admin") // admin | user
  ipAddress  String?
  createdAt  DateTime @default(now())

  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([commentId])
  @@index([editorId])
  @@index([action])
  @@index([createdAt])
}

// =============================================
// OFFLINE STORAGE — Background Sync for Affiliate Clicks
// =============================================

model OfflineClick {
  id             String   @id @default(cuid())
  affiliateUrl   String
  productId      String?
  productSlug    String?
  userId         String?
  sessionId      String?
  userAgent      String?
  referrer       String?
  syncedAt       DateTime?
  createdAt      DateTime @default(now())

  @@index([syncedAt])
  @@index([createdAt])
}

// =============================================
// COMPETITOR ALERTS — Competitive Intelligence Storage
// =============================================

model CompetitorAlert {
  id              String   @id @default(cuid())
  type            String   // "new_product" | "price_change" | "content_update" | "trend_shift"
  competitorName  String
  competitorUrl   String
  productName     String?
  productUrl      String?
  oldPrice        Decimal? @db.Decimal(10, 2)
  newPrice        Decimal? @db.Decimal(10, 2)
  changePercent   Decimal? @db.Decimal(5, 2)
  category        String?
  severity        String   // "low" | "medium" | "high"
  suggestedAction String?  @db.Text
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([type, createdAt])
  @@index([competitorName])
  @@index([severity])
  @@index([dismissed, createdAt])
}

// =============================================
// INVENTORY ALERTS — Stockout Predictions & Warnings
// =============================================

model InventoryAlert {
  id                 String   @id @default(cuid())
  productId          String
  productName        String
  productSlug        String
  currentStock       Int      @default(0)
  dailySalesRate     Decimal  @default(0) @db.Decimal(10, 4)
  daysUntilOutOfStock Int?
  predictedDate      DateTime?
  reorderPoint       Int      @default(0)
  confidence         String   // "high" | "medium" | "low"
  salesVelocity      String   // "increasing" | "stable" | "declining"
  seasonality        String?
  recommendations    String[]
  dismissed          Boolean  @default(false)
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([daysUntilOutOfStock])
  @@index([createdAt])
  @@index([dismissed])
}

// =============================================
// IMPORT PRESETS — User-saved column mappings
// =============================================

model ImportPreset {
  id        String   @id @default(cuid())
  name      String
  network   String   // AffiliateNetwork name or "CUSTOM"
  columns   Json     // { "name": "title", "price": "sale_price", ... }
  defaultNetwork String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// =============================================
// IMPORT HISTORY — Persisted import jobs
// =============================================

model ImportHistory {
  id        String   @id @default(cuid())
  fileName   String
  totalRows  Int      @default(0)
  newRows    Int      @default(0)
  matchedRows Int     @default(0)
  failedRows Int      @default(0)
  status     String   @default("completed") // completed | failed | processing
  errors     Json?    // Array of { row: number, message: string }
  categoriesLinked Int  @default(0)
  tagsLinked       Int  @default(0)
  affiliateLinksCreated Int @default(0)
  mediaCreated     Int  @default(0)
  presetId         String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// End of schema — designed for horizontal scaling, read replicas, and graph queries.
