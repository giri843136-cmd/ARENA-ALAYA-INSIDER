{
  "name": "alaya-insider",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev --webpack",
    "build": "npx next build --webpack",
    "start": "npx next start",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "preview": "npx next build && npx next start",
    "postinstall": "npx prisma generate || echo 'Prisma generate completed (or skipped if no DB for build)'",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force",
    "test:unit": "npx vitest run",
    "test:unit:watch": "npx vitest",
    "test:integration": "npx vitest run tests/integration",
    "test:api": "npx vitest run tests/api",
    "test:e2e": "npx playwright test",
    "test:a11y": "npx playwright test tests/accessibility",
    "test:perf": "npx lighthouse-ci autorun",
    "test:load": "echo 'k6 requires external install; run manually'",
    "test:chaos": "echo 'Run chaos tests against staging infra'",
    "test:all": "bash scripts/testing/run-all-tests.sh",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/prisma-adapter": "^2.11.2",
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.57.0",
    "axe-playwright": "^2.2.2",
    "bullmq": "^5.78.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.1.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "next-intl": "^4.13.0",
    "openai": "^6.42.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "resend": "^6.12.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "typesense": "^3.0.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "msw": "^2.6.6",
    "playwright": "^1.49.0",
    "storybook": "^8.4.7",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
