# =============================================
# ALAYA INSIDER — Environment Configuration
# =============================================
# Copy this file to .env and fill in your real values.
# Required vars will crash the app if missing in production.
# Optional vars gracefully degrade functionality.
# =============================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/alaya_insider?schema=public"
# Required. PostgreSQL connection string.

# --- Redis ---
REDIS_URL="redis://localhost:6379"
# Required. For BullMQ queues, caching, sessions.

# --- Typesense (Search) ---
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="dev-key"
# Optional. Without these, search gracefully degrades.

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-a-random-64-char-secret-here-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"
# Required. NEXTAUTH_SECRET must be 32+ chars in production.
# In production, use https://yourdomain.com

PRIMARY_ADMIN_PASSWORD="YourSecurePassword123!"
# Required for seeding. Change immediately after first login via Security Center.

# --- Google OAuth (Admin Login) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Without these, Google login is disabled.

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Optional. Without this, transactional emails are skipped gracefully.

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional. Without these, image upload is disabled.

# --- AI Providers ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional. Without these, AI Workspace uses mock providers only.

# --- AI Safety & Cost Control ---
AI_MAX_COST_PER_TASK="0.50"
AI_MONTHLY_BUDGET="200"
# Optional. Prevents runaway AI costs in production.

# --- Observability ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Optional. Without these, error tracking and tracing are disabled.

# --- Affiliate Networks ---
AMAZON_ASSOCIATE_TAG="your-tag-20"
IMPACT_API_KEY=""
CJ_API_KEY=""
# Optional. Used for affiliate link generation.

# --- App Settings ---
NEXT_PUBLIC_SITE_URL="https://alayainsider.com"
NODE_ENV="development"
